@echo off
setlocal
cd /d %~dp0
set ROOT=%~dp0
powershell -NoProfile -ExecutionPolicy Bypass -Command "$root='%ROOT%'; $log=Join-Path $root 'data\run.log'; New-Item -ItemType Directory -Path (Join-Path $root 'data') -Force | Out-Null; Add-Content $log ('[' + (Get-Date) + '] start'); $cfg=Join-Path $root '.venv\pyvenv.cfg'; if (Test-Path $cfg) { $venvPy=Join-Path $root '.venv\Scripts\python.exe'; $sysPy=(Get-Command python -ErrorAction SilentlyContinue | Select-Object -First 1 -ExpandProperty Source); $launcherPy=(Get-Command py -ErrorAction SilentlyContinue | Select-Object -First 1 -ExpandProperty Source); $resolvedPy=@($venvPy,$sysPy,$launcherPy) | Where-Object { $_ -and (Test-Path $_) } | Select-Object -First 1; if ($resolvedPy) { $pyHome=Split-Path -Parent $resolvedPy; $pyVersion=''; try { $pyVersion=& $resolvedPy -c \"import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}')\" } catch { $pyVersion='' }; if (-not $pyVersion) { $pyVersion='3.10.6' }; $cfgLines=@('home = ' + $pyHome, 'include-system-site-packages = false', 'version = ' + $pyVersion); Set-Content -Path $cfg -Value $cfgLines -Encoding ASCII; Add-Content $log ('[' + (Get-Date) + '] cfg=' + $resolvedPy + ' version=' + $pyVersion) } else { Add-Content $log ('[' + (Get-Date) + '] cfg python detect failed') } }; $pyw=Join-Path $root '.venv\Scripts\pythonw.exe'; $py=Join-Path $root '.venv\Scripts\python.exe'; if (!(Test-Path $pyw)) { $pyw=$py } if (!(Test-Path $pyw)) { $pyw='pythonw.exe' } Add-Content $log ('[' + (Get-Date) + '] python=' + $pyw); $p=Start-Process -FilePath $pyw -ArgumentList '-m','app.tray' -WorkingDirectory $root -WindowStyle Hidden -PassThru; Add-Content $log ('[' + (Get-Date) + '] pid=' + $p.Id)"
